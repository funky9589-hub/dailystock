# Gemini API 金鑰（可於 Google AI Studio 取得：https://aistudio.google.com/apikey）
GEMINI_API_KEY=your_gemini_api_key_here

# 寄件者 Gmail 信箱（你的 Gmail 帳號）
SENDER_EMAIL=your_email@gmail.com

# Gmail 16 位應用程式密碼（需先開啟 Google 兩步驟驗證，於「應用程式密碼」產生，可去掉空格）
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# 收件人清單（多位訂閱者請用半形逗號分隔，寄送時會自動以 Bcc 密件副本保護隱私）
RECIPIENT_EMAILS=me@gmail.com,friend1@gmail.com

# 市場關注焦點（預設為 台股與美股連動）
MARKET_FOCUS=台股與美股連動

# （選填）使用的 Gemini 模型，預設為 gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# （選填）GitHub Pages 3D 互動翻牌網頁網址（設定後信中會自動顯示「開啟 3D 互動翻牌版」按鈕）
# 例如：https://你的帳號.github.io/dailystock/
# INTERACTIVE_URL=
